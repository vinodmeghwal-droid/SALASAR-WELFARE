# ── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed by CORS (the Next.js app)
CORS_ORIGIN=http://localhost:3000

# ── MongoDB ──────────────────────────────────────────────
# e.g. mongodb://127.0.0.1:27017/hr-welfare  or an Atlas SRV string
MONGODB_URI=mongodb+srv://vinodmeghwal_db_user:<db_password>@welfare.c5rhate.mongodb.net/?appName=Welfare

# ── Internal auth (must equal frontend BACKEND_API_KEY) ──
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# ── Data source ──────────────────────────────────────────
# drive = Google Drive (production) | local = a local .xlsx (offline dev)
DATA_SOURCE=drive
DRIVE_FILE_ID=1zX5lpXgQcoyz5QJDRyJQCFc-jQb3SEM1
SYNC_INTERVAL_SECONDS=30

# Google service account with read access to the file (share the file with this email as Viewer).
# Either inline credentials…
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the quotes; newlines as \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# …or a path to the downloaded JSON key file (takes precedence when set)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# Only when DATA_SOURCE=local
LOCAL_WORKBOOK_PATH=test/fixtures/officer-return-2026-27.xlsx
