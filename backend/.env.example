# ── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed by CORS (the Next.js app)
CORS_ORIGIN=http://localhost:3000

# ── MongoDB ──────────────────────────────────────────────
# e.g. mongodb://127.0.0.1:27017/hr-welfare  or an Atlas SRV string
MONGODB_URI=mongodb+srv://vinodmeghwal_db_user:<db_password>@welfare.c5rhate.mongodb.net/?appName=Welfare

# ── Internal auth (must equal frontend BACKEND_API_KEY) ──
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# ── Data source ──────────────────────────────────────────
# drive = Google Drive (production) | local = a local .xlsx (offline dev)
DATA_SOURCE=drive
DRIVE_FILE_ID=1zX5lpXgQcoyz5QJDRyJQCFc-jQb3SEM1
SYNC_INTERVAL_SECONDS=30

# Drive credentials — option A (recommended): read as the file owner via OAuth.
# Use the same OAuth client as sign-in; add redirect URI http://localhost:5555/oauth2callback,
# then run `npm run drive:authorize` and paste the printed refresh token here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Drive credentials — option B: a service account (…@….iam.gserviceaccount.com) the file is shared with as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the quotes; newlines as \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# …or a path to the downloaded JSON key file (takes precedence when set)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# Only when DATA_SOURCE=local
LOCAL_WORKBOOK_PATH=test/fixtures/officer-return-2026-27.xlsx

# ── AI insights (Gemini, optional) ───────────────────────
# Key from https://aistudio.google.com/apikey — server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Tried in order when the primary model is overloaded or unavailable
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-flash-lite-latest
